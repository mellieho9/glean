{
  "manifest_version": 3,
  "name": "Glean",
  "description": "Extract structured data from videos, PDFs, and web pages into your databases",
  "version": "1.2.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "http://glean-alb-982788137.us-east-1.elb.amazonaws.com/*",
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
